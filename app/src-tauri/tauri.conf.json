{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenObsidian",
  "version": "0.1.0",
  "identifier": "dev.openobsidian.desktop",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --dir ui dev",
    "beforeBuildCommand": "pnpm --dir ui build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "OpenObsidian",
        "width": 1400,
        "height": 900,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "backgroundColor": "#ffffff",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "publisher": "OpenObsidian",
    "copyright": "© OpenObsidian contributors, MIT (canvas feature uses tldraw, non-commercial; see THIRD_PARTY_NOTICES)",
    "shortDescription": "Local-first, file-as-truth knowledge base",
    "longDescription": "OpenObsidian — a local-first, MIT-licensed knowledge management app. Adds the two things Obsidian most needs: graph visualization and live aggregate queries (QQL).",
    "resources": {
      "../../LICENSE": ".",
      "../../THIRD_PARTY_NOTICES.md": ".",
      "../../licenses/tldraw-LICENSE.md": "."
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
